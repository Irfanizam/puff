# Sentry configuration.
# These are optional for local development — leave empty to disable Sentry.
# Required for production deployment.

# Server-side DSN (used by sentry.server.config.ts and sentry.edge.config.ts)
SENTRY_DSN=

# Browser-side DSN (used by sentry.client.config.ts)
# Note: NEXT_PUBLIC_ prefix exposes this to the browser. DSNs are designed
# to be publishable — they identify the project, not authorize it.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organization slug (for source map upload at build time)
SENTRY_ORG=

# Sentry project slug (for source map upload at build time)
SENTRY_PROJECT=

# Sentry auth token (for source map upload at build time)
# Generate at: https://sentry.io/orgs/YOUR_ORG/auth-tokens/
# Scopes needed: project:releases, project:read
SENTRY_AUTH_TOKEN=

# Toggle to enable Sentry in development.
# When false, all Sentry calls are no-ops — no events sent.
# Useful for testing Sentry integration locally without burning your quota.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
